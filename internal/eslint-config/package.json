{
  "name": "@moleculer/eslint-config",
  "version": "1.0.0",
  "description": "ESLint configuration of Moleculer framework packages",
  "type": "module",
  "exports": {
    "./nodejs.mjs": "./nodejs.mjs"
  },
  "scripts": {
    "format": "prettier . --ignore-unknown --check",
    "format:fix": "prettier . --ignore-unknown --write",
    "lint": "TIMING=1 eslint ."
  },
  "peerDependencies": {
    "eslint": "catalog:"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "@moleculer/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "typescript-eslint": "8.67.0"
  },
  "devDependencies": {
    "@types/eslint-config-prettier": "6.11.3",
    "prettier": "catalog:"
  }
}
