{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // jest runs CommonJS; override the nodenext ESM build settings
    // (temporary until the vitest migration; node10 resolution is deprecated in TS6)
    "module": "commonjs",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "rootDir": "./",
    "sourceMap": true,
    "inlineSourceMap": true
  }
}
