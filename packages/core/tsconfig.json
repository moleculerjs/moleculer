{
  "extends": "@moleculer/tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "types": ["node", "reflect-metadata", "vitest/globals"],
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    // add all typechecked paths here
    "src/**/*", // source folder
    "examples/**/*", // source folder
    "./.*.cjs", // root commonjs config files
    "./.*.mjs", // root esm config files
    "./.*.js", // root javascript config files
    "./*.js", // root javascript files
    "./*.mjs", // root esm files
    "test/**/*", // test folder
    "vitest.config.ts" // test config file
  ]
}
