{
  "name": "@moleculer/core",
  "version": "1.0.0-alpha.1",
  "description": "Core package of Moleculer framework",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      }
    }
  },
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsx watch examples/index.ts",
    "format": "prettier . --ignore-unknown --check",
    "format:fix": "prettier . --ignore-unknown --write",
    "lint": "TIMING=1 eslint .",
    "ci": "vitest",
    "test": "vitest run"
  },
  "keywords": [
    "microservice",
    "microservices",
    "moleculer",
    "framework",
    "backend",
    "messagebus",
    "rpc",
    "services",
    "micro",
    "pubsub",
    "scalable",
    "distributed"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moleculerjs/moleculer.git"
  },
  "funding": "https://github.com/moleculerjs/moleculer?sponsor=1",
  "author": "MoleculerJS",
  "license": "MIT",
  "engines": {
    "node": ">= 24.x.x"
  },
  "devDependencies": {
    "@moleculer/eslint-config": "workspace:*",
    "@moleculer/tsconfig": "workspace:*",
    "@moleculer/vitest-config": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "^4.23.12",
    "vitest": "catalog:"
  },
  "dependencies": {
    "es-toolkit": "^1.50.0"
  }
}
